# ==============================================================================
# PIPER Rescue Intelligence - Backend Environment Configuration
# ==============================================================================

# Port and host for the dashboard backend service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Upstream Robot API base URL (Friend's ROS 2 bridge service)
# Example local LAN: http://192.168.1.120:8080 or http://localhost:8080
PIPER_ROBOT_API_URL=http://localhost:8080

# Request timeout in seconds for upstream robot HTTP requests
ROBOT_API_TIMEOUT_SECONDS=4.0

# When true, the backend provides simulated fallback data if upstream robot is unreachable
ENABLE_SIMULATION_FALLBACK=true

# Allowed CORS origins for the Next.js frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# SOS Emergency Response System Configuration
# ==============================================================================
# Maximum SOS requests per minute per IP / user before rate-limiting triggers
EMERGENCY_RATE_LIMIT_PER_MINUTE=15
# Coarsening/retention period for high-precision location data (days)
EMERGENCY_RETENTION_DAYS=90
# Optional external PostgreSQL / Supabase connection (for production migration)
# SUPABASE_POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
